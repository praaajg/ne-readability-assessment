# Large data (>~10MB): ignored; small committed tables are EXCEPTED below.
# NOTE: features_v*/scores_* stay local (112MB feature table exceeds the git
# file-size limit) — rebuild them from the committed corpus snapshot with
# rebuild.py (repo root), which uses only the installed library + pandas.
data/processed/*.csv
!data/processed/splits/.gitkeep
!data/processed/stats_*.csv
!data/processed/formula_*.csv
!data/processed/comparison_*.csv
!data/processed/pairwise_*.csv
!data/processed/anomaly_clusters_*.csv
